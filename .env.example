# Single allowlisted account (required). Never commit the real value.
ALLOWED_EMAIL=you@example.com

# HMAC secret for session/token signing, >= 32 chars (required).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public origin of the app (used for magic links + CSRF origin check).
APP_URL=http://localhost:3000

# Hosted Postgres. When unset, dev uses embedded PGlite at PGLITE_DIR.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
PGLITE_DIR=./.data/pglite

# OpenAI. Absent -> deterministic MockProvider is used.
# OPENAI_API_KEY=

# Resend (magic-link email). Absent -> link printed to server console.
# RESEND_API_KEY=
# RESEND_FROM=English Mastery <login@yourdomain.com>

# Model configuration (defaults shown).
AI_MODEL_FRONTIER=gpt-6-astra
AI_MODEL_BALANCED=gpt-6.1-sol
AI_MODEL_FAST=gpt-6-luna
STT_MODEL=gpt-transcribe
STT_TIMESTAMP_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Local audio storage (dev). Audio retention defaults to Off.
AUDIO_STORAGE_DIR=./.data/audio
